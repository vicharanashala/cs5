# Query.in Backend Environment Variables
# Copy this file to .env and fill in your values

# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection
# For local development, use: mongodb://localhost:27017/queryin
# For cloud MongoDB Atlas, replace with your connection string
MONGO_URI=mongodb://localhost:27017/queryin
DB_NAME=queryin

# JWT Authentication
# Generate a strong random string for JWT_SECRET (use: openssl rand -hex 32)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d

# Client URL (for CORS)
CLIENT_URL=http://localhost:5173

# Grok Cloud API (for AI/LLM fallback)
GROK_API_KEY=your-grok-api-key
GROK_MODEL=llama-3.3-70b-versatile