# Query.in Backend Environment Variables
# Copy this file to .env and fill in your values

# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection
# For local development, use: mongodb://localhost:27017/queryin
# For cloud MongoDB Atlas, replace with your connection string
MONGO_URI=mongodb://localhost:27017/queryin
DB_NAME=queryin

# JWT Authentication
# Generate a strong random string for JWT_SECRET (use: openssl rand -hex 32)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d

# Client URL (for CORS)
CLIENT_URL=http://localhost:5173

# Gemini API (tries in order: 3.5-flash -> 3.1-pro -> 3.1-flash-lite -> 2.5-flash -> 2.5-pro)
GEMINI_API_KEY=your-gemini-api-key

# Groq API (Fallback when Gemini fails, tries in order: llama-3.3-70b -> llama-3.1-8b -> llama-4-scout -> qwen3-32b -> gpt-oss-120b -> gpt-oss-20b)
GROQ_API_KEY=your-groq-api-key